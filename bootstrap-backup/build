#!/usr/bin/env bash
set -euo pipefail

# Single entry point: build both app-only and merged release artifacts.
# Optional:
#   FIRMWARE_VERSION=v1.0.0 ./build

if [[ ! -x "scripts/build-touch.sh" ]]; then
  echo "Error: scripts/build-touch.sh is missing or not executable." >&2
  exit 1
fi

if [[ -z "${FIRMWARE_VERSION:-}" ]]; then
  FIRMWARE_VERSION="v$(date -u +%Y.%m.%d-%H%M%S)"
fi

echo "Using build tag: ${FIRMWARE_VERSION}"

echo "Building release app-only + merged binaries..."
FIRMWARE_VERSION="${FIRMWARE_VERSION}" scripts/build-touch.sh release

echo "Done. Latest app-only and merged binaries are in out/."
